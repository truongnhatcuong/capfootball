# Copy to .env; never commit real credentials.
DATABASE_URL=mysql://capfootball:capfootball_local@localhost:3306/capfootball
AUTH_URL=http://localhost:3019
PORT=3019
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=
CRON_SECRET=
REDIS_URL=redis://localhost:6379
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap1
PUSHER_SECRET=
# Nodemailer SMTP (Gmail example). Use an App Password for Gmail.
# Port 465: SMTP_SECURE=true; port 587 (STARTTLS): SMTP_SECURE=false.
# Fill SMTP_USER, SMTP_PASS and EMAIL_FROM to enable notification emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
LOG_LEVEL=info
