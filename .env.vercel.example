DATABASE_URL=mysql://USER:PASSWORD@HOST/capfootball?sslaccept=strict
AUTH_URL=https://YOUR-PROJECT.vercel.app
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=
CRON_SECRET=
# TLS Redis URL from your managed provider (e.g. Upstash Redis TCP endpoint).
REDIS_URL=rediss://default:PASSWORD@HOST:6379
REALTIME_DRIVER=pusher
NEXT_PUBLIC_REALTIME_DRIVER=pusher
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap1
PUSHER_SECRET=
# Nodemailer SMTP (Gmail example). Use an App Password for Gmail.
# Port 465: SMTP_SECURE=true; port 587 (STARTTLS): SMTP_SECURE=false.
# Fill SMTP_USER, SMTP_PASS and EMAIL_FROM to enable notification emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
