# Existing MySQL/Redis services, reachable from the Linux VPS host.
DATABASE_URL=mysql://USER:PASSWORD@YOUR_MYSQL_HOST:3306/capfootball
REDIS_URL=redis://127.0.0.1:6379
AUTH_URL=https://football.example.com
PORT=3019
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=
CRON_SECRET=
REALTIME_DRIVER=socketio
# Set these public values in GitHub Actions Variables for the image build.
NEXT_PUBLIC_REALTIME_DRIVER=socketio
NEXT_PUBLIC_SOCKET_URL=
SOCKET_PORT=3020
# Nodemailer SMTP (Gmail example). Use an App Password for Gmail.
# Port 465: SMTP_SECURE=true; port 587 (STARTTLS): SMTP_SECURE=false.
# Fill SMTP_USER, SMTP_PASS and EMAIL_FROM to enable notification emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
