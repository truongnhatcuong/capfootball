# Existing MySQL/Redis services, reachable from the Docker container.
DATABASE_URL=mysql://USER:PASSWORD@YOUR_MYSQL_HOST:3306/capfootball
REDIS_URL=rediss://default:PASSWORD@YOUR_REDIS_HOST:6379
AUTH_URL=https://football.example.com
# Public VPS port mapped to the web container; change to suit your reverse proxy.
PORT=3019
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=
CRON_SECRET=
PUSHER_APP_ID=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap1
PUSHER_SECRET=
# Nodemailer SMTP (Gmail example). Use an App Password for Gmail.
# Port 465: SMTP_SECURE=true; port 587 (STARTTLS): SMTP_SECURE=false.
# Fill SMTP_USER, SMTP_PASS and EMAIL_FROM to enable notification emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
