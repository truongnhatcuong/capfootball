# Local source build. CI deployments can override this with an immutable GHCR tag.
APP_IMAGE=capfootball:local
APP_DOMAIN=football.example.com
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_ROOT_PASSWORD
MYSQL_USER=capfootball
MYSQL_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
MYSQL_DATABASE=capfootball
DATABASE_URL=mysql://capfootball:REPLACE_WITH_A_RANDOM_PASSWORD@mysql:3306/capfootball
REDIS_URL=redis://redis:6379
AUTH_URL=https://football.example.com
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=
CRON_SECRET=
REALTIME_DRIVER=socketio
# These public variables are passed as build args when building your own image.
NEXT_PUBLIC_REALTIME_DRIVER=socketio
NEXT_PUBLIC_SOCKET_URL=
SOCKET_PORT=3001
# Nodemailer SMTP (Gmail example). Use an App Password for Gmail.
# Port 465: SMTP_SECURE=true; port 587 (STARTTLS): SMTP_SECURE=false.
# Fill SMTP_USER, SMTP_PASS and EMAIL_FROM to enable notification emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
